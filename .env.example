# ==============================================================================
# NAGJAN E-Commerce Environment Configuration
# ==============================================================================

# Groq Cloud API Key for AI Chatbot (Never expose this in frontend code)
# Obtain a free or paid API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (Default: openai/gpt-oss-20b)
# Alternative active models: qwen/qwen3.8-27b, openai/gpt-oss-120b, allam-2-7b
GROQ_MODEL=openai/gpt-oss-20b

# Business WhatsApp Phone Number (International format without '+' or spaces, e.g. 919445566288)
NEXT_PUBLIC_WHATSAPP_NUMBER=919445566288
